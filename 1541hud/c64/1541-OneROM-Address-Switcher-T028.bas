10 PRINTCHR$(147):PRINT"1541 ADDRESS SWITCHER T0.0.28":PRINT
20 PRINT"SETTING DRIVE 8 TO 10..."
30 OPEN15,8,15
40 PRINT#15,"M-W"+CHR$(119)+CHR$(0)+CHR$(2)+CHR$(42)+CHR$(74)
50 CLOSE15
60 FORI=1TO100:NEXTI
70 OPEN15,10,15
